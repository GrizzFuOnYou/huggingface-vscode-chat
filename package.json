{
	"name": "huggingface-vscode-chat",
	"publisher": "HuggingFace",
	"displayName": "Hugging Face Provider for GitHub Copilot Chat",
	"description": "An extension that integrates Hugging Face Inference Providers into GitHub Copilot Chat",
	"icon": "assets/logo.png",
	"repository": {
		"type": "git",
		"url": "https://github.com/huggingface/huggingface-vscode-chat"
	},
	"version": "0.1.0",
	"engines": {
		"vscode": "^1.104.0"
	},
	"categories": [
		"AI",
		"Chat"
	],
	"galleryBanner": {
		"color": "#100f11",
		"theme": "dark"
	},
	"badges": [
		{
		"url": "https://img.shields.io/github/stars/huggingface/huggingface-vscode-chat?style=social",
		"description": "Star huggingface-vscode-chat on Github",
		"href": "https://github.com/huggingface/huggingface-vscode-chat"
		},
		{
		"url": "https://img.shields.io/twitter/follow/huggingface?style=social",
		"description": "Follow Hugging Face on Twitter",
		"href": "https://x.com/huggingface"
		}
	],
	"homepage": "https://huggingface.co/docs/inference-providers/en/index",
	"bugs": {
		"url": "https://github.com/huggingface/huggingface-vscode-chat/issues"
	},
	"license": "MIT",
	"contributes": {
		"languageModelChatProviders": [
			{
				"vendor": "huggingface",
				"displayName": "Hugging Face",
				"managementCommand": "huggingface.manage"
			}
		],
		"commands": [
			{
				"command": "huggingface.manage",
				"title": "Manage Hugging Face Provider"
			},
			{
				"command": "huggingface.clearApiKey",
				"title": "Clear Hugging Face API Key"
			},
			{
				"command": "huggingface.refreshModels",
				"title": "Refresh Hugging Face Model List"
			}
		],
		"configuration": {
			"title": "Hugging Face",
			"properties": {
				"huggingface.routing": {
					"type": "string",
					"enum": ["all", "cheapest", "fastest"],
					"enumDescriptions": [
						"Show all provider-specific entries plus cheapest and fastest shortcuts",
						"Show only the cheapest-provider entry for each model",
						"Show only the fastest-provider entry for each model"
					],
					"default": "all",
					"description": "Controls which routing-mode model entries appear in the model picker."
				},
				"huggingface.defaultTemperature": {
					"type": "number",
					"default": 0.7,
					"minimum": 0,
					"maximum": 2,
					"description": "Default sampling temperature used when the caller does not specify one."
				},
				"huggingface.maxOutputTokens": {
					"type": "number",
					"default": 4096,
					"minimum": 1,
					"maximum": 16000,
					"description": "Default maximum number of output tokens when the caller does not specify one."
				},
				"huggingface.includeNonToolModels": {
					"type": "boolean",
					"default": false,
					"description": "Include models that do not support tool calling in the model picker."
				},
				"huggingface.modelCacheTtlMinutes": {
					"type": "number",
					"default": 5,
					"minimum": 1,
					"maximum": 60,
					"description": "How long (in minutes) to cache the model list fetched from Hugging Face before re-fetching."
				}
			}
		}
	},
	"main": "./out/extension.js",
	"scripts": {
		"vscode:prepublish": "npm run compile",
		"download-api": "dts dev",
		"postdownload-api": "dts main",
		"postinstall": "npm run download-api",
		"compile": "tsc -p ./",
		"lint": "eslint",
		"format": "prettier --write .",
		"watch": "tsc -watch -p ./",
		"test": "pnpm run compile && vscode-test"
	},
	"dependencies": {},
	"devDependencies": {
		"@eslint/js": "^9.13.0",
		"@stylistic/eslint-plugin": "^2.9.0",
		"@types/node": "^22",
		"@types/mocha": "^10.0.6",
		"@vscode/dts": "^0.4.1",
		"@types/vscode": "^1.103.0",
		"@vscode/test-cli": "^0.0.11",
		"@vscode/test-electron": "^2.5.2",
		"eslint": "^9.13.0",
		"prettier": "^3.1.0",
		"typescript": "^5.9.2",
		"typescript-eslint": "^8.39.0"
	},
	"packageManager": "pnpm@8.15.4+sha512.0bd3a9be9eb0e9a692676deec00a303ba218ba279d99241475616b398dbaeedd11146f92c2843458f557b1d127e09d4c171e105bdcd6b61002b39685a8016b9e"
}
